{
  "client_type": {
    "type": "string",
    "default": "api",
    "description": "客户端类型：api=API客户端（推荐，支持收藏添加/评论翻页/签到，不支持分类筛选），html=HTML客户端（支持分类筛选，收藏添加/评论翻页受限）"
  },
  "username": {
    "type": "string",
    "default": "",
    "description": "禁漫天堂用户名（留空则不登录）"
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "禁漫天堂密码"
  },
  "domain": {
    "type": "string",
    "default": "",
    "description": "禁漫镜像站域名（多个用英文逗号分隔，自动切换可用的）"
  },
  "allow_group": {
    "type": "bool",
    "default": true,
    "description": "允许在群聊中使用（关闭后仅私聊可用）"
  },
  "photo_threads": {
    "type": "int",
    "default": 2,
    "description": "章节下载并发数（1-16）"
  },
  "image_threads": {
    "type": "int",
    "default": 5,
    "description": "图片下载并发数（1-32）"
  },
  "per_page": {
    "type": "int",
    "default": 10,
    "description": "搜索结果每页显示条数（5-20）"
  },
  "convert_enabled": {
    "type": "bool",
    "default": true,
    "description": "开启繁转简转换"
  },
  "convert_title": {
    "type": "bool",
    "default": true,
    "description": "转换标题为简体"
  },
  "convert_tags": {
    "type": "bool",
    "default": true,
    "description": "转换标签为简体"
  },
  "convert_author": {
    "type": "bool",
    "default": true,
    "description": "转换作者为简体"
  },
  "convert_comment": {
    "type": "bool",
    "default": true,
    "description": "转换评论为简体"
  },
  "sensitive_filter": {
    "type": "bool",
    "default": true,
    "description": "开启敏感词自动转拼音"
  },
  "custom_sensitive": {
    "type": "text",
    "description": "敏感词转拼音规则，每行一条：敏感词=拼音"
  },
  "tease_enabled": {
    "type": "bool",
    "default": true,
    "description": "开启下载次数调侃提醒"
  },
  "cache_days": {
    "type": "int",
    "default": 7,
    "description": "下载图片缓存保留天数（0为永久保留）"
  },
  "comment_count": {
    "type": "int",
    "default": 10,
    "description": "评论最多显示条数（1-10）"
  },
  "history_max": {
    "type": "int",
    "default": 50,
    "description": "下载历史最多保留条数（10-100）"
  },
  "dual_search": {
    "type": "bool",
    "default": true,
    "description": "开启简繁双搜索：自动同时用简/繁体关键词搜索，避免漏结果"
  }
}
